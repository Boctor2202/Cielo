{
  "expo": {
    "name": "Geardown",
    "slug": "strato",
    "scheme": "geardown",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A1626",
    "ios": {
      "bundleIdentifier": "app.geardown.logbook",
      "buildNumber": "1",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "fr",
          "en"
        ]
      }
    },
    "android": {
      "package": "app.geardown.logbook",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E2A47"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "locales": {
      "fr": {
        "CFBundleDisplayName": "Geardown",
        "NSPhotoLibraryUsageDescription": "Geardown utilise vos photos pour votre photo de profil et la photo de votre CV.",
        "NSCameraUsageDescription": "Geardown utilise l'appareil photo pour prendre votre photo de profil."
      },
      "en": {
        "CFBundleDisplayName": "Geardown",
        "NSPhotoLibraryUsageDescription": "Geardown uses your photos for your profile picture and the photo on your CV.",
        "NSCameraUsageDescription": "Geardown uses the camera to take your profile picture."
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-localization",
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0E2A47"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0A1626"
          }
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Geardown uses your photos for your profile picture and the photo on your CV.",
          "cameraPermission": "Geardown uses the camera to take your profile picture.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c9d2903e-0e29-4c2d-a381-cd385e436c1e"
      }
    },
    "owner": "strato-app",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/c9d2903e-0e29-4c2d-a381-cd385e436c1e"
    }
  }
}
