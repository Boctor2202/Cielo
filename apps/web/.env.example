# Leave empty to run in local mode (data stays in the browser, no account).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: production base-map style (MapTiler, Stadia…). Defaults to a sober style on the MapLibre demo tiles.
NEXT_PUBLIC_MAP_STYLE_URL=
# Google Maps for the routes map: browser key restricted to your site (HTTP referrers) and to "Maps JavaScript API".
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
