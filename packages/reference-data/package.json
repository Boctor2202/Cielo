{
  "name": "@cielo/reference-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": { ".": "./src/index.ts", "./airports.json": "./data/airports.json", "./runways.json": "./data/runways.json", "./airlines.json": "./data/airlines.json", "./timezones.json": "./data/timezones.json" },
  "scripts": {
    "build:airports": "node scripts/build-airports.mjs raw/airports.csv data/airports.json",
    "build:runways": "node scripts/build-runways.mjs raw/runways.csv data/airports.json data/runways.json",
    "build:airlines": "node scripts/build-airlines.mjs raw/airlines.dat data/airlines.json"
  },
  "dependencies": { "@cielo/core": "workspace:*" },
  "devDependencies": { "tz-lookup": "^6.1.25", "papaparse": "^5.5.3" }
}
